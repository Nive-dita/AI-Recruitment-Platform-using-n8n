    {
      "parameters": {
        "jsCode": "const rows = $input.all();\n\nconst total = rows.length;\n\nlet shortlisted = 0;\nlet selected = 0;\nlet rejected = 0;\nlet interview = 0;\n\nlet scoreSum = 0;\nlet scoreCount = 0;\n\nfor (const row of rows) {\n  const data = row.json;\n\n  if (data.Status === \"Shortlist\") {\n    shortlisted++;\n  }\n\n  if (data.Status === \"Interview Scheduled\") {\n    interview++;\n  }\n\n  if (data[\"Final Decision\"] === \"Selected\") {\n    selected++;\n  }\n\n  if (\n    data[\"Final Decision\"] === \"Rejected\" ||\n    data.Status === \"Rejected\"\n  ) {\n    rejected++;\n  }\n\n  const score = Number(data[\"Resume Score\"]);\n\n  if (!isNaN(score) && score !== 0) {\n    scoreSum += score;\n    scoreCount++;\n  }\n}\n\nconst average = scoreCount > 0\n  ? Number((scoreSum / scoreCount).toFixed(2))\n  : 0;\n\nreturn [\n  {\n    json: {\n      ID: 1,\n      \"Total Candidates\": total,\n      \"AI Shortlisted\": shortlisted,\n      \"Interview Scheduled\": interview,\n      \"Selected\": selected,\n      \"Rejected\": rejected,\n      \"Average Resume Score\": average,\n      Timestamp: new Date().toISOString()\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
